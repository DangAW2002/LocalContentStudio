{
  "name": "local-content-studio-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Local Content Studio — Standalone Desktop Creative Production Workspace",
  "scripts": {
    "dev": "pnpm --filter @studio/desktop-ui dev",
    "desktop": "node packages/desktop-ui/node_modules/@tauri-apps/cli/tauri.js dev",
    "tauri": "node packages/desktop-ui/node_modules/@tauri-apps/cli/tauri.js",
    "build": "pnpm --recursive run build",
    "test": "pnpm --recursive run test",
    "typecheck": "pnpm --recursive run typecheck",
    "lint": "pnpm --recursive run lint",
    "cargo:check": "cargo check --workspace",
    "cargo:test": "cargo test --workspace",
    "e2e:smoke": "node scripts/e2e/smoke.mjs",
    "gate": "powershell -ExecutionPolicy Bypass -File scripts/gate.ps1"
  },
  "packageManager": "pnpm@11.22.0"
}
