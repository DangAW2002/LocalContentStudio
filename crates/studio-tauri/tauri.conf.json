{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Content Studio",
  "version": "0.1.0",
  "identifier": "studio.localcontent.app",
  "build": {
    "frontendDist": "../../packages/desktop-ui/dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "Local Content Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": [] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
