{
  "id": "tts.synthesize",
  "version": 1,
  "title": "Text-to-Speech Synthesis",
  "description": "Synthesizes spoken audio from provided text",
  "input_schema": {
    "type": "object",
    "properties": {
      "text": {
        "type": "string",
        "description": "Text to synthesize into audio"
      },
      "voice": {
        "type": "string",
        "description": "Optional voice identifier"
      },
      "speed": {
        "type": "number",
        "description": "Optional speech speed multiplier (e.g. 1.0)"
      },
      "reference_audio": {
        "type": "string",
        "description": "Optional relative path to reference audio in workspace for voice cloning"
      },
      "output_path": {
        "type": "string",
        "description": "Relative output path in workspace for wav/mp3 file"
      }
    },
    "required": ["text"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "audio_path": {
        "type": "string"
      },
      "provider": {
        "type": "string"
      },
      "voice": {
        "type": "string"
      },
      "available_voices": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "note": {
        "type": "string"
      }
    },
    "required": ["audio_path"]
  }
}
