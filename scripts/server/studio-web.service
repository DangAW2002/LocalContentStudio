[Unit]
Description=Local Content Studio (Web Headless)
After=network.target tailscaled.service
Wants=network.target

[Service]
Type=simple
Environment=STUDIO_APP_DIR=%h/.local/share/local-content-studio
Environment=PATH=%h/.local/bin:%h/.cargo/bin:/usr/local/bin:/usr/bin:/bin
# Headless web mode (chạy ngầm, không GUI, nghe loopback port 3000).
# Khi dùng qua Tailscale Serve (HTTPS) PHẢI thêm --behind-https-proxy --allowed-host <máy>.<tailnet>.ts.net,
# nếu không mọi request qua tên ts.net bị chặn 403 (xem docs/huong-dan/may-chu-linux.md mục 6.2).
ExecStart=%h/.local/bin/studio-tauri --headless --port 3000
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=15s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
